# =============================================================================
# ERP ELEAM — Plantilla de entorno para producción (Docker + PostgreSQL)
# =============================================================================
# Copiar a .env.production y completar:
#   copy .env.production.example .env.production    (Windows)
#   cp   .env.production.example .env.production    (Linux/Mac)
#
# Generar una APP_KEY y contraseñas seguras:
#   php artisan key:generate --show
#   (o en Linux/Mac: openssl rand -base64 32)
# =============================================================================

APP_NAME="ERP ELEAM"
APP_ENV=production
APP_KEY=base64:GENERAR_CON_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Base de datos PostgreSQL (los valores de host/puerto los fija Docker) ────
DB_CONNECTION=pgsql
DB_DATABASE=eleam
DB_USERNAME=eleam
DB_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
# DB_HOST y DB_PORT se definen en docker-compose.yml (servicio "postgres")
# Cliente PostgreSQL para respaldos (Docker ya lo incluye en /usr/bin).
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore

# Ejecuta `php artisan migrate --force` automáticamente al iniciar el contenedor
RUN_MIGRATIONS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@eleam.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Puerto público donde se servirá la aplicación (docker-compose)
APP_PORT=8000

# ─── GOOGLE DRIVE BACKUP (Producción) ──────────────────────────────────────
# GOOGLE_DRIVE_CREDENTIALS_PATH=/var/www/html/google-drive-credentials.json
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=ID_CARPETA_DRIVE
# GOOGLE_DRIVE_BACKUP_RETENTION=30
